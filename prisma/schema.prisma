generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EscrowStatus {
  PENDING     // created, not funded
  AUTHORIZED  // PI authorized (requires_capture)
  COMPLETE    // all milestones captured
  CANCELED
}

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  name            String
  password        String
  // Back-relations (must match the relation names used on Escrow)
  escrowsBuying   Escrow[] @relation("Buyer")
  escrowsSelling  Escrow[] @relation("Seller")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt @default(now())
}

model Escrow {
  id                    Int           @id @default(autoincrement())
  title                 String?
  buyerId               Int
  sellerId              Int
  amountCents           Int
  status                EscrowStatus  @default(PENDING)
  stripePaymentIntentId String?

  // Milestones relation
  milestones            Milestone[]   @relation("EscrowMilestones")

  // Buyer/Seller relations (names must match back-refs on User)
  buyer                 User          @relation("Buyer", fields: [buyerId], references: [id])
  seller                User          @relation("Seller", fields: [sellerId], references: [id])

  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt @default(now())
}

model Milestone {
  id                Int       @id @default(autoincrement())
  escrowId          Int
  description       String?
  amountCents       Int
  releaseConditions String?
  dueDate           DateTime?
  released          Boolean   @default(false)
  escrow            Escrow    @relation("EscrowMilestones", fields: [escrowId], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt @default(now())
}
