generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserType {
  CUSTOMER
  VENDOR
  BOTH
}

enum EscrowStatus {
  PENDING     // created, not funded
  AUTHORIZED  // PI authorized (requires_capture)
  COMPLETE    // all milestones captured
  CANCELED
}

enum ProjectStatus {
  PLANNING
  ACTIVE      // vendors booked, payments in progress
  COMPLETED
  CANCELED
}

enum ProjectVendorStatus {
  INVITED     // customer added vendor, vendor hasn't accepted
  ACCEPTED    // vendor accepted
  PAID        // escrow funded
  COMPLETED   // service delivered, payment released
  CANCELED
}

// ============================================
// USERS
// ============================================

model User {
  id              Int      @id @default(autoincrement())
  email           String   @unique
  name            String
  password        String
  userType        UserType @default(CUSTOMER)
  
  // Vendor-specific fields (null for customers)
  stripeAccountId String?  @unique  // For Stripe Connect
  bio             String?
  services        String[] // ["photography", "catering", "dj"]
  portfolioUrls   String[] // Can store image URLs
  location        String?  // "Detroit, MI"
  phoneNumber     String?
  
  // Relations
  projectsOwned       Project[]        @relation("ProjectOwner")
  projectVendorRoles  ProjectVendor[]  @relation("VendorUser")
  escrowsBuying       Escrow[]         @relation("Buyer")
  escrowsSelling      Escrow[]         @relation("Seller")
  rfpsCreated         RFP[]  // As customer
  bidsSubmitted       Bid[]  // As vendor
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")

  profileImageUrl  String?
  startingPrice    Int?        // in cents, like other amounts
  instagramHandle  String?
  websiteUrl       String?
  yearsInBusiness  Int?
}

// ============================================
// PROJECTS
// ============================================

model Project {
  id              Int            @id @default(autoincrement())
  title           String
  description     String?
  totalBudget     Int?           // in cents, optional
  eventDate       DateTime?
  location        String?
  pinterestBoard  String?        // URL to Pinterest board
  status          ProjectStatus  @default(PLANNING)
  
  // Owner
  customerId      Int
  customer        User           @relation("ProjectOwner", fields: [customerId], references: [id])
  
  // Relations
  vendors         ProjectVendor[]
  rfps            RFP[]
  
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

// ============================================
// PROJECT VENDORS (the "booking")
// ============================================

model ProjectVendor {
  id              Int                  @id @default(autoincrement())
  
  // Links
  projectId       Int
  project         Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendorId        Int
  vendor          User                 @relation("VendorUser", fields: [vendorId], references: [id])
  
  // Booking details
  role            String               // "Photographer", "Caterer", "DJ"
  description     String?              // "Need photos from 2-10pm"
  amountCents     Int                  // Total amount for this vendor
  dueDate         DateTime?            // When payment/service is due
  status          ProjectVendorStatus  @default(INVITED)
  
  // Payment
  escrow          Escrow?              @relation("ProjectVendorEscrow")
  
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  
  @@unique([projectId, vendorId])
}

// ============================================
// ESCROW (updated)
// ============================================

model Escrow {
  id                    Int                  @id @default(autoincrement())
  
  // Links
  projectVendorId       Int                  @unique
  projectVendor         ProjectVendor        @relation("ProjectVendorEscrow", fields: [projectVendorId], references: [id], onDelete: Cascade)
  
  buyerId               Int
  sellerId              Int
  buyer                 User                 @relation("Buyer", fields: [buyerId], references: [id])
  seller                User                 @relation("Seller", fields: [sellerId], references: [id])
  
  // Payment details
  amountCents           Int
  status                EscrowStatus         @default(PENDING)
  stripePaymentIntentId String?
  
  // Relations
  milestones            Milestone[]          @relation("EscrowMilestones")
  
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
}

// ============================================
// MILESTONES
// ============================================

model Milestone {
  id                Int       @id @default(autoincrement())
  escrowId          Int
  description       String?
  amountCents       Int
  releaseConditions String?
  dueDate           DateTime?
  released          Boolean   @default(false)
  
  escrow            Escrow    @relation("EscrowMilestones", fields: [escrowId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

enum RFPStatus {
  OPEN
  AWARDED
  CLOSED
}

enum BidStatus {
  SUBMITTED
  ACCEPTED
  REJECTED
}

enum RFPVisibility {
  PUBLIC
  PRIVATE
}

model RFP {
  id          Int       @id @default(autoincrement())
  projectId   Int?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customerId  Int
  customer    User      @relation(fields: [customerId], references: [id])
  
  title       String
  description String
  budget      Int?
  deadline    DateTime?
  status      RFPStatus   @default(OPEN)
  
  // Event details
  eventDate      DateTime?
  location       String?
  guestCount     Int?
  
  // Style & inspiration
  inspirationUrl String?
  styleTags      String[]
  
  // Requirements
  mustHaves      String[]
  niceToHaves    String[]
  
  // Timeline
  decisionDate   DateTime? 
  
  // Visibility
  visibility       RFPVisibility @default(PUBLIC)
  invitedVendorIds Int[]
  
  bids        Bid[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Bid {
  id          Int       @id @default(autoincrement())
  rfpId       Int
  rfp         RFP       @relation(fields: [rfpId], references: [id], onDelete: Cascade)
  vendorId    Int
  vendor      User      @relation(fields: [vendorId], references: [id])
  
  amount      Int       // Bid amount in cents
  proposal    String    // Vendor's proposal text
  status      BidStatus @default(SUBMITTED)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  @@unique([rfpId, vendorId]) // Vendor can only bid once per RFP
}

model Message {
  id          Int      @id @default(autoincrement())
  senderId    Int
  receiverId  Int
  content     String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  sender      User     @relation("SentMessages", fields: [senderId], references: [id])
  receiver    User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
}