generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
}

model Escrow {
  id                    Int         @id @default(autoincrement())
  title                 String? // ✅ NEW
  buyerId               Int
  sellerId              Int
  amount                Float
  status                String
  stripePaymentIntentId String?
  milestones            Milestone[] @relation("EscrowMilestones") // ✅ Named relation
}

model Milestone {
  id       Int     @id @default(autoincrement())
  escrowId Int
  amount   Float
  released Boolean @default(false)

  escrow Escrow @relation("EscrowMilestones", fields: [escrowId], references: [id]) // ✅ Matches above
}
